#version 450

// MGSV: a resolved depth texture (k_24_8 / k_24_8_FLOAT, held on the host as R32_SFLOAT numeric guest-space depth)
// that the game samples as k_8_8_8_8 - Fox Engine reads its 984x720 depth this way in its lighting / fog passes and
// rebuilds the depth from the bytes. The guest texture would hold one 32-bit word per texel: the 24-bit depth (unorm
// for k_24_8, 20e4 float for k_24_8_FLOAT) above the 8-bit stencil. This writes that word as RGBA8 in the same byte
// order as me_edram_depth_to_rgba8.comp (R = bits 0-7). The stencil is not part of the resolved image: written as 0.
//
// Bindings follow layout_conversion_depth_edram_ (sa2_native_targets.cpp): 0 = sampled depth, 1 = storage target,
// 2 = stencil (declared for layout compatibility, never read).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D source_depth;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D target;
layout(set = 0, binding = 2) uniform usampler2D unused_stencil;
layout(push_constant) uniform Constants {
  uvec2 extent;        // logical size written (the fetch's width x height)
  uvec2 source_size;   // the resolved image's extent, for bounds
  uint float24;        // 1 = k_24_8_FLOAT (20e4), 0 = k_24_8 (unorm24)
} c;

// ReXGlue xenos.cpp Float32To20e4, as in me_edram_depth_to_rgba8.comp (without its rounding option).
uint A20e4(float z) {
  if (!(z > 0.0)) return 0u;  // Also rejects NaN and negative zero.
  uint bits = floatBitsToUint(z);
  if (bits >= 0x3FFFFFF8u) return 0xFFFFFFu;
  if (bits < 0x38800000u) {
    bits = ((bits & 0x7FFFFFu) | 0x800000u) >> min(113u - (bits >> 23u), 24u);
  } else {
    bits += 0xC8000000u;
  }
  return (bits >> 3u) & 0xFFFFFFu;
}

void main() {
  uvec2 q = gl_GlobalInvocationID.xy;
  if (any(greaterThanEqual(q, c.extent))) return;
  float z = all(lessThan(q, c.source_size)) ? texelFetch(source_depth, ivec2(q), 0).r : 0.0;
  uint depth = c.float24 != 0u ? A20e4(z) : uint(roundEven(clamp(z, 0.0, 1.0) * 16777215.0));
  uint word = depth << 8u;  // the stencil (low byte) is not part of the resolved image
  uvec4 bytes = uvec4(word, word >> 8u, word >> 16u, word >> 24u) & 255u;
  imageStore(target, ivec2(q), vec4(bytes) * (1.0 / 255.0));
}
